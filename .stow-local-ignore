# Held back from `stow`, because the repo root mirrors $HOME but not everything
# in it is $HOME content.
#
# Patterns are Perl regexes anchored against the path relative to this package.
#
# Stow's built-in ignore list (.git, .gitignore, README.*, LICENSE.* and so on)
# is NOT used once this file exists: this file replaces it. So those entries
# have to be listed here, or stow links ~/.git at the repo and turns the whole
# home directory into a git working tree.

# Repo metadata.
^/\.git$
^/\.gitignore$
^/README.*
^/LICENSE.*

# Bootstrap machinery - not config.
^/bootstrap\.ps1$
^/bootstrap\.sh$
^/install$
^/\.gitattributes$
^/\.stow-local-ignore$

# Reached by $KOMOREBI_CONFIG_HOME, never linked into $HOME. Windows-only.
^/komorebi$

# Dot-sourced by a generated stub at $PROFILE, not linked. Windows-only.
^/powershell$

