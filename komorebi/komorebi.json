{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.39/schema.json",
  "app_specific_configuration_path": "$KOMOREBI_CONFIG_HOME/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 2,
  "default_container_padding": 1,
  "border": true,
  "border_width": 1,
  "border_offset": -1,
  "theme": {
    "palette": "Base16",
    "name": "CatppuccinFrappe",
    "unfocused_border": "Base03",
    "bar_accent": "Base0D"
  },
  "monitors": [
    {
      "workspaces": [
        {
          "name": "W",
          "layout": "Grid"
        },
        {
          "name": "B",
          "layout": "Grid"
        },
        {
          "name": "C1",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "C2",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "C3",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "M1",
          "layout": "Grid"
        },
        {
          "name": "M2",
          "layout": "Grid"
        }
      ]
    }
  ]
}
