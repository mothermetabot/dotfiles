# The repo root mirrors $HOME and .config/* is junctioned (Windows) or stowed
# (Linux) into place, so anything a tool writes into its own config directory
# lands here. Everything below was previously tracked by accident for exactly
# that reason.

# --- machine-local overrides -------------------------------------------------
*.local
*.pre-dotfiles
.bashrc.local
.bash_profile.local
powershell/profile.local.ps1

# --- generated per-platform, not tracked -------------------------------------
# Nothing is generated any more - tmux.conf branches internally with if-shell.
# Only runtime plugin installs land here (TPM on Linux).
.config/tmux/plugins/

# --- tool-written state ------------------------------------------------------
# nvim writes logs next to its config
.nvimlog
startup.log
.config/nvim/.claude/
.config/nvim/doc/tags

# scoop and uv drop receipts and timestamps into XDG config
.config/scoop/
.config/uv/

# gitk window geometry
.config/git/gitk
.config/git/gitk.bak

# --- Claude Code --------------------------------------------------------------
# Only .claude/{skills,agents,commands} and settings.json are deployed; the
# rest of ~/.claude is session state and must never be committed. These are
# belt-and-braces: nothing links them in today, but .credentials.json reaching
# a git repo is bad enough to be worth spelling out.
.claude/.credentials.json
.claude/history.jsonl
.claude/projects/
.claude/sessions/
.claude/session-env/
.claude/shell-snapshots/
.claude/todos/
.claude/tasks/
.claude/teams/
.claude/backups/
.claude/cache/
.claude/paste-cache/
.claude/file-history/
.claude/statsig/
.claude/settings.local.json

# --- vendored upstream data, fetched by bootstrap ----------------------------
# 62 KB of third-party window rules. komorebi regenerates it with
# `komorebic fetch-app-specific-configuration`; bootstrap.ps1 does that for you.
komorebi/applications.json

# --- editors / OS ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
